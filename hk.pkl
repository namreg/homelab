amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    stash = "git"

    steps {
      ["markdown"] {
        glob = "**/*.md"
        check = "rumdl check -- {{files}}"
      }

      ["okf"] {
        check = "mise run lint:okf"
      }

      ["secrets"] {
        check = "mise run lint:secrets:staged"
      }
    }
  }
}
